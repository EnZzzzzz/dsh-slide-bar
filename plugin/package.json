{
  "name": "dsh-slide-bar",
  "description": "dsh Web UI plugin: a VSCode-style Explorer sidebar panel (activity-bar icon + lazy file tree over the current session's working directory)",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "bundle": "tsc -p tsconfig.json && tsdown",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:/Volumes/DataDrive/proj/public/deepseek-harness/vendor/cordis",
    "@deepseek-ai/dsh-client-locale": "link:/Volumes/DataDrive/proj/public/deepseek-harness/packages/client/locale",
    "@deepseek-ai/dsh-client-runtime": "link:/Volumes/DataDrive/proj/public/deepseek-harness/packages/client/runtime",
    "@deepseek-ai/dsh-client-test-runtime": "link:/Volumes/DataDrive/proj/public/deepseek-harness/packages/test-support/client-runtime",
    "@deepseek-ai/dsh-client-ui-primitives": "link:/Volumes/DataDrive/proj/public/deepseek-harness/packages/client/ui-primitives",
    "@deepseek-ai/dsh-client-ui-sidebar": "link:/Volumes/DataDrive/proj/public/deepseek-harness/packages/client/ui-sidebar",
    "@deepseek-ai/dsh-client-ui-slots": "link:/Volumes/DataDrive/proj/public/deepseek-harness/packages/client/ui-slots",
    "@deepseek-ai/dsh-client-web-react": "link:/Volumes/DataDrive/proj/public/deepseek-harness/packages/client/web-react",
    "@deepseek-ai/dsh-invariants": "link:/Volumes/DataDrive/proj/public/deepseek-harness/packages/runtime-diagnostics/invariants",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "~18.3.1",
    "jsdom": "29.1.1",
    "lightningcss": "^1.32.0",
    "react": "link:/Volumes/DataDrive/proj/public/deepseek-harness/packages/client/ui-primitives/node_modules/react",
    "react-dom": "link:/Volumes/DataDrive/proj/public/deepseek-harness/packages/client/ui-primitives/node_modules/react-dom",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "@deepseek-ai/dsh-client-ui-conversation": "link:/Volumes/DataDrive/proj/public/deepseek-harness/packages/client/ui-conversation"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ]
}
